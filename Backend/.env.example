# Server Configuration
PORT=3001

# PostgreSQL Database (Direct connection or Supabase pooler)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]

# Supabase Admin / Service Role
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Cron Job Secret
CRON_SECRET=your-secret-token-for-cron-triggers

# AI Service (OpenAI / DeepSeek / AI Gateway)
OPENAI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4.1-mini

# Email Configuration (Optional - Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=info@acudigiverse.com

